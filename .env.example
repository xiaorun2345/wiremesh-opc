# ── 应用配置 ──────────────────────────────────────────────────
APP_NAME=WireMesh OPC
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── 数据库 ────────────────────────────────────────────────────
# Docker 环境下自动覆盖为容器内地址，本地开发时使用下面的值
DATABASE_URL=mysql+pymysql://wiremesh:change-me@localhost:3306/wiremesh_opc
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=change-me

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_CELERY=true
AUTO_CREATE_TABLES=false

# ── LLM — 文本模型 ────────────────────────────────────────────
# Claude API（默认）
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# 本地 Ollama（私有化部署时替代 Claude API）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── 多模态大模型 API ──────────────────────────────────────────
# 用于 VisionParseAgent 图纸视觉解析
# 支持 claude | openai_compatible | zhipu | custom

# 当前使用：智谱 AI GLM-5V
MULTIMODAL_PROVIDER=zhipu
MULTIMODAL_MODEL=glm-5v-turbo
MULTIMODAL_API_KEY=your-zhipu-api-key
MULTIMODAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MULTIMODAL_MAX_TOKENS=4096

# Claude 多模态（备用）
# MULTIMODAL_PROVIDER=claude
# MULTIMODAL_MODEL=claude-opus-4-6

# OpenAI-compatible（GPT-4o 等）
# MULTIMODAL_PROVIDER=openai_compatible
# MULTIMODAL_BASE_URL=https://api.openai.com/v1
# MULTIMODAL_API_KEY=your-openai-api-key
# MULTIMODAL_MODEL=gpt-4o

# ── MinIO 文件存储 ────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wiremesh-opc
MINIO_SECURE=false

# ── MinerU PDF 解析 ───────────────────────────────────────────
MINERU_API_URL=https://mineru.net/api/kie
MINERU_PIPELINE_ID=your-pipeline-id
MINERU_API_KEY=your-mineru-api-key

# ── 向量库 ChromaDB ───────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8002
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── 文件上传 ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ── OPC 自动化 ────────────────────────────────────────────────
WECOM_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INBOUND_WEBHOOK_TOKEN=replace-with-a-long-random-token
SAM_GOV_API_KEY=

# Optional lead-alert email. Leave blank to keep notifications inside the platform.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAILS=
